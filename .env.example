# =============================================================================
# Configuration template for Bitcoin After Life Will Executor
# =============================================================================
# Copy this file to .env and edit the values:
#   cp .env.example .env
#
# Required: BAL_BITCOIN_ADDRESS (your bc1q... address to collect fees)
#           BAL_BITCOIN_FEE      (minimum fee in satoshis per transaction)
#
# Optional: BAL_PUBLIC_URL       (public domain, e.g. https://we.safe21.io)
#           BAL_SEND_STATS       (set "true" to send anonymous usage stats)
#           BAL_LOG_LEVEL        (info, debug, trace; default: info)
#
# The following are auto-detected by scripts/configure-umbrel.sh:
#   APP_BITCOIN_NODE_IP, APP_BITCOIN_RPC_PORT, APP_BITCOIN_RPC_USER, etc.
# =============================================================================

# --- Required: Payment settings ---
BAL_BITCOIN_ADDRESS=bc1qxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BAL_BITCOIN_FEE=30000

# --- Optional: Public URL for Cloudflare/external access ---
BAL_PUBLIC_URL=

# --- Optional: Stats ---
BAL_SEND_STATS=false
BAL_LOG_LEVEL=info

# --- Auto-detected (run scripts/configure-umbrel.sh) ---
APP_BITCOIN_NODE_IP=
APP_BITCOIN_RPC_PORT=8332
APP_BITCOIN_RPC_USER=
APP_BITCOIN_RPC_PASS=
BAL_ZMQ_PORT=28334
APP_BITCOIN_DATA_DIR=
APP_DATA_DIR=
